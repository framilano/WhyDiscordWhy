{
    "encoding_choice": 2,
    "target_size_mb": "10",
    "target_resolution": "1280:720",
    "target_video_codec": "av1_vaapi",
    "target_audio_bitrate": "32",
    "target_audio_codec": "libopus",
    "target_fps": "30",
    "theme_file_name": "theme.json",
    "ffmpeg_mapping": {
        "nt": {
            "cpu": {
                "default_video_codec": "libx265",
                "pass1": "$FFMPEG_PATH -y -i $INPUT -c:v $VIDEO_CODEC -b:v $VIDEO_BITRATEk -filter:v fps=$FPS,scale=$RESOLUTION -x265-params pass=1 -an -f mp4 NUL",
                "pass2": "$FFMPEG_PATH -y -i $INPUT -c:v $VIDEO_CODEC -b:v $VIDEO_BITRATEk -filter:v fps=$FPS,scale=$RESOLUTION -x265-params pass=2 -c:a $AUDIO_CODEC -b:a $AUDIO_BITRATEk $OUTPUT"
            },
            "amd": {
                "default_video_codec": "hevc_amf",
                "pass1": "",
                "pass2": "$FFMPEG_PATH -i $INPUT -c:v $VIDEO_CODEC -b:v $VIDEO_BITRATEk -maxrate $VIDEO_BITRATEk -bufsize $DOUBLE_VID_BITRATEk -filter:v fps=$FPS,scale=$RESOLUTION -c:a $AUDIO_CODEC -b:a $AUDIO_BITRATEk $OUTPUT"
            },
            "nvidia": {
                "default_video_codec": "hevc_nvenc",
                "pass1": "",
                "pass2": "$FFMPEG_PATH -i $INPUT -c:v $VIDEO_CODEC -b:v $VIDEO_BITRATEk -maxrate $VIDEO_BITRATEk -bufsize $DOUBLE_VID_BITRATEk -filter:v fps=$FPS,scale=$RESOLUTION -c:a $AUDIO_CODEC -b:a $AUDIO_BITRATEk $OUTPUT"
            },
            "intel": {
                "default_video_codec": "hevc_qsv",
                "pass1": "",
                "pass2": "$FFMPEG_PATH -i $INPUT -c:v $VIDEO_CODEC -b:v $VIDEO_BITRATEk -maxrate $VIDEO_BITRATEk -bufsize $DOUBLE_VID_BITRATEk -filter:v fps=$FPS,scale=$RESOLUTION -c:a $AUDIO_CODEC -b:a $AUDIO_BITRATEk $OUTPUT"
            }
        },
        "nx": {
            "cpu": {
                "default_video_codec": "libx265",
                "pass1": "$FFMPEG_PATH -y -i $INPUT -c:v $VIDEO_CODEC -b:v $VIDEO_BITRATEk -filter:v fps=$FPS,scale=$RESOLUTION -x265-params pass=1 -an -f mp4 /dev/null",
                "pass2": "$FFMPEG_PATH -y -i $INPUT -c:v $VIDEO_CODEC -b:v $VIDEO_BITRATEk -filter:v fps=$FPS,scale=$RESOLUTION -x265-params pass=2 -c:a $AUDIO_CODEC -b:a $AUDIO_BITRATEk $OUTPUT"
            },
            "amd": {
                "default_video_codec": "av1_vaapi",
                "pass1": "",
                "pass2":"$FFMPEG_PATH -y -init_hw_device vaapi=gpu:/dev/dri/renderD128 -hwaccel vaapi -hwaccel_output_format vaapi -hwaccel_device gpu -i $INPUT -filter_hw_device gpu -vf format=nv12|vaapi,hwupload,scale_vaapi=$RESOLUTION,fps=$FPS -c:v $VIDEO_CODEC -b:v $VIDEO_BITRATEk -maxrate $VIDEO_BITRATEk -bufsize $DOUBLE_VID_BITRATEk -c:a $AUDIO_CODEC -b:a $AUDIO_BITRATEk $OUTPUT"
            }
        }
    }
}